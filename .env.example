# Copy to .env (gitignored, never committed) and choose your own value.
# Used by docker-compose.yml for the offline SQL Server container. Must satisfy SQL
# Server complexity rules: 8+ characters with upper, lower, digit, and symbol.
SQL_SA_PASSWORD=ChangeMe-to-a-Strong-Passw0rd!

